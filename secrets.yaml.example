# Lyra - Credentials sensibles (template)
# Copier en secrets.yaml et remplir avec les vraies valeurs
# secrets.yaml est gitignore - ne jamais committer les vraies valeurs

tv:
  user: "VOTRE_USER_TV"
  pass: "VOTRE_PASS_TV_64CHARS_HEX"

hue:
  username: "VOTRE_HUE_API_TOKEN"         # phue / REST API classique
  beat_username: "VOTRE_HUE_BEAT_USER"    # Entertainment API (hue_beat.py)
  clientkey: "VOTRE_HUE_CLIENTKEY_HEX"    # 32 chars hex -- Entertainment API PSK
  area_id: "VOTRE_AREA_UUID"              # UUID de l'Entertainment Area

homeassistant:
  token: "VOTRE_HA_LONG_LIVED_TOKEN"

n8n:
  api_key: "VOTRE_N8N_API_KEY"

discord:
  webhook_url: "https://discord.com/api/webhooks/ID/TOKEN"
